{
  "name": "dark-studio",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:agent": "tsx apps/agent/src/index.ts",
    "dev:desktop": "tauri dev",
    "build": "npm run check && vite build",
    "check": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.agent.json",
    "test": "vitest run",
    "tauri": "tauri",
    "dev:render": "tsx apps/agent/src/render-worker.ts",
    "smoke:render": "tsx scripts/smoke-render.ts"
  },
  "dependencies": {
    "@openai/codex-sdk": "^0.164.0",
    "@remotion/player": "^4.0.360",
    "@tauri-apps/api": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.360",
    "zod": "^3.24.0",
    "zustand": "^5.0.0",
    "@remotion/bundler": "^4.0.360",
    "@remotion/renderer": "^4.0.360"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tsx": "^4.19.0",
    "typescript": "~5.8.3",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
