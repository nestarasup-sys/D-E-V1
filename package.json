{
  "name": "dark-studio",
  "private": true,
  "version": "0.17.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:agent": "npm run dev:service",
    "dev:desktop": "tauri dev",
    "build": "npm run check && vite build",
    "check": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.agent.json",
    "test": "vitest run",
    "tauri": "tauri",
    "dev:render": "tsx apps/agent/src/render-worker.ts",
    "smoke:render": "tsx scripts/smoke-render.ts",
    "dev:service": "tsx apps/agent/src/index.ts",
    "project": "tsx scripts/project-tool.ts",
    "smoke:pilot": "tsx scripts/smoke-pilot.ts",
    "smoke:service": "tsx scripts/smoke-service.ts",
    "smoke:motion": "tsx scripts/smoke-motion.ts",
    "preview:frames": "tsx scripts/preview-frames.ts",
    "smoke:advanced": "tsx scripts/smoke-advanced.ts"
  },
  "dependencies": {
    "@remotion/player": "^4.0.360",
    "@tauri-apps/api": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.360",
    "zod": "^3.24.0",
    "zustand": "^5.0.0",
    "@remotion/bundler": "^4.0.360",
    "@remotion/renderer": "^4.0.360",
    "fflate": "^0.8.2",
    "pngjs": "^7.0.0",
    "yazl": "^3.3.1",
    "yauzl": "^3.4.0",
    "tesseract.js": "^6.0.1",
    "@tesseract.js-data/por": "^1.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tsx": "^4.19.0",
    "typescript": "~5.8.3",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^2.4.6"
  }
}
